# Anthropic API key — leave empty or set to "mock_api_key" to run 100% FREE local mode
ANTHROPIC_API_KEY=mock_api_key

# Shared secret — must match BACKEND_SECRET in frontend .env
BACKEND_SECRET=local_backend_secret

# Admin dashboard passcode — must match ADMIN_SECRET_KEY in frontend .env
ADMIN_SECRET_KEY=admin123

# Neon Postgres connection URL (leave as SQLite default for local development)
# Neon format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./datamirror.db

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting — requests per minute per (hashed) IP
RATE_LIMIT_PER_MINUTE=60

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
